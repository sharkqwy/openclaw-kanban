{
  "name": "openclaw-kanban",
  "version": "2.0.0",
  "description": "Mission Control — Visual task management, agent orchestration, and real-time monitoring for OpenClaw",
  "type": "module",
  "license": "MIT",
  "author": "OpenClaw",
  "bin": {
    "openclaw-kanban": "bin/cli.js"
  },
  "files": [
    "bin",
    "dist",
    "dist-server"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sharkqwy/openclaw-kanban.git"
  },
  "homepage": "https://github.com/sharkqwy/openclaw-kanban#readme",
  "bugs": {
    "url": "https://github.com/sharkqwy/openclaw-kanban/issues"
  },
  "keywords": [
    "openclaw",
    "kanban",
    "task-management",
    "markdown",
    "drag-and-drop"
  ],
  "scripts": {
    "dev": "concurrently \"npm run server\" \"vite\"",
    "dev:client": "vite",
    "server": "tsx watch src/server/index.ts",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hono/node-server": "^1.19.9",
    "better-sqlite3": "^12.6.2",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "framer-motion": "^12.34.1",
    "hono": "^4.11.9",
    "lucide-react": "^0.574.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "uuid": "^13.0.0",
    "zod": "^4.3.6",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@tailwindcss/vite": "^4.0.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^5.1.1",
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "jsdom": "^28.1.0",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.21.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^7.2.4",
    "vitest": "^4.0.18"
  }
}
